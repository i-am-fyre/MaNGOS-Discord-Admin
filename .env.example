# Copy to .env (git-ignored) and fill in. Never commit the real values.
# Write each value straight after the "=", without quotes. See README section 5.

# Developer Portal > your application > Bot > Reset Token > Copy
DISCORD_TOKEN=

# Password of the MySQL user created with docs/database-user.sql
MANGOS_DB_PASSWORD=

# Only if SOAP is enabled: the gmlevel 3 account created for the bot
SOAP_USERNAME=
SOAP_PASSWORD=
